  "evidencia": [
   {
    "app": "mi",
    "archivo": "ui.jsx:180-240",
    "detalle": "showSearch, multi, borderRadius: 16 (panel) y 11 (opción)"
   },
   {
    "app": "hola",
    "archivo": "app/shell.jsx:186",
    "detalle": "function PillSelect({ … multi, searchable … }) · borderRadius: 16"
   },
   {
    "app": "docs",
    "archivo": "panel-ui.jsx:62-70",
    "detalle": "PanelSelect: panel borderRadius: 16, buscador sticky"
   },
   {
    "app": "mi",
    "archivo": "sa-combo.jsx:30",
    "detalle": ".sac-pop { border-radius: 14px } — tercera variante dentro de la misma app"
   },
   {
    "app": "ds",
    "archivo": "components/forms/Select.jsx",
    "detalle": "panel var(--r-lg), opción var(--r-sm), sin búsqueda ni multi"
   }
  ],
  "vistas": [
   {
    "etiqueta": "Design system hoy",
    "app": "ds",
    "alto": 290,
