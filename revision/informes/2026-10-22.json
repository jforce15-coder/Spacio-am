    "css": "\n.wrap{padding:20px;background:var(--bg);font-family:var(--font-sans)}\n.trg{display:inline-flex;align-items:center;gap:10px;background:var(--bg);border:1px solid var(--color-ink-08);border-radius:999px;padding:10px 14px 10px 16px;font-size:12px;font-weight:500;color:var(--fg);box-shadow:var(--shadow-xs);min-width:200px}\n.trg span{flex:1}.chev{width:8px;height:8px;border-right:1.5px solid var(--fg-muted);border-bottom:1.5px solid var(--fg-muted);transform:rotate(225deg);margin-top:4px}\n.pop{margin-top:8px;width:250px;background:var(--bg);border:1px solid var(--color-ink-08);box-shadow:var(--shadow-md);padding:6px}\n.opt{display:flex;align-items:center;gap:10px;padding:11px 12px;font-size:12.5px;color:var(--fg)}\n.opt.on{background:var(--bg-alt);font-weight:500}\n.ck{margin-left:auto;color:var(--accent);font-size:14px}\n"
   },
   {
    "etiqueta": "Mi · Hola · Docs (PillSelect)",
    "app": "mi",
    "alto": 330,
    "html": "<div class=\"wrap\"><div class=\"trg\"><span>Propiedades</span><b class=\"n\">2</b><i class=\"chev\"></i></div>\n<div class=\"pop\" style=\"border-radius:16px\"><div class=\"srch\">⌕&nbsp; Buscar…</div>\n<div class=\"opt\" style=\"border-radius:11px\"><i class=\"bx\"></i>Todas las propiedades</div>\n<div class=\"opt on\" style=\"border-radius:11px\"><i class=\"bx on\">✓</i>Casa Ceiba</div>\n<div class=\"opt on\" style=\"border-radius:11px\"><i class=\"bx on\">✓</i>Loft Cayalá</div>\n<div class=\"opt\" style=\"border-radius:11px\"><i class=\"bx\"></i>Estudio Zona 10</div></div></div>",
    "css": "\n.wrap{padding:20px;background:var(--bg);font-family:var(--font-sans)}\n.trg{display:inline-flex;align-items:center;gap:10px;background:var(--bg);border:1px solid var(--color-ink-08);border-radius:999px;padding:10px 14px 10px 16px;font-size:12px;font-weight:500;color:var(--fg);box-shadow:var(--shadow-xs);min-width:200px}\n.trg span{flex:1}.chev{width:8px;height:8px;border-right:1.5px solid var(--fg-muted);border-bottom:1.5px solid var(--fg-muted);transform:rotate(225deg);margin-top:4px}\n.pop{margin-top:8px;width:250px;background:var(--bg);border:1px solid var(--color-ink-08);box-shadow:var(--shadow-md);padding:6px}\n.opt{display:flex;align-items:center;gap:10px;padding:11px 12px;font-size:12.5px;color:var(--fg)}\n.opt.on{background:var(--bg-alt);font-weight:500}\n.ck{margin-left:auto;color:var(--accent);font-size:14px}\n\n.n{min-width:17px;height:17px;padding:0 5px;border-radius:999px;background:var(--accent);color:#fff;font-size:9.5px;font-weight:700;display:inline-flex;align-items:center;justify-content:center}\n.srch{margin:4px 4px 8px;background:var(--bg-alt);border:1px solid var(--color-ink-08);border-radius:10px;padding:9px 11px;font-size:12.5px;color:var(--fg-muted)}\n.bx{width:17px;height:17px;border-radius:5px;border:1.5px solid var(--divider);display:inline-flex;align-items:center;justify-content:center;font-style:normal;font-size:11px;color:#fff;box-sizing:border-box}\n.bx.on{background:var(--accent);border-color:var(--accent)}\n"
   }
  ]
 },
