{
  "$meta": {
    "name": "Spacio AM Design System",
    "version": "2.0.0",
    "description": "Fuente única de verdad de los design tokens de Spacio AM. Genera tokens.css y el objeto JS de las apps. No editar valores directamente en las apps: editar aquí.",
    "brand": "Spacio AM",
    "contrastStandard": "WCAG 2.1 AA",
    "date": "2026-08-13"
  },

  "color": {
    "_comment": "Capa base (color crudo). Los 6 hex de marca vienen del Dashboard = base del sistema. Se conservan intactos como swatches; el acceso accesible a texto se resuelve en la capa semántica.",
    "brand": {
      "ink":        { "value": "#3E3F3F", "use": "Texto primario, titulares. Contraste 10.1:1 sobre alabaster." },
      "alabaster":  { "value": "#FAFAFA", "use": "Fondo primario." },
      "beige":      { "value": "#F5F3F0", "use": "Fondo secundario, relleno de brushstroke, superficies cálidas." },
      "earth":      { "value": "#938B8A", "use": "Swatch de marca. Texto SOLO >=18px o decorativo (falla AA en texto pequeño: 3.19:1)." },
      "warm-grey":  { "value": "#D8D4CE", "use": "Divisores, líneas sutiles. No usar como texto." },
      "peach":      { "value": "#E9826A", "use": "Acento gráfico: puntos, subrayados, bordes, tintes, acentos hero. NO como texto ni relleno de botón con texto (2.56:1)." },
      "peach-deep": { "value": "#C83E1E", "use": "Acento sólido accesible: botón de acento con texto blanco (5.0:1). Mismo tono que peach, oscurecido." },
      "graphite":   { "value": "#6F6867", "use": "Texto secundario accesible (reemplaza a earth como texto pequeño). 5.2:1 sobre alabaster, 4.9:1 sobre beige." },
      "white":      { "value": "#FFFFFF", "use": "Superficie elevada (cards, modales)." }
    },
    "tint": {
      "ink-08":   { "value": "rgba(62,63,63,0.08)" },
      "ink-16":   { "value": "rgba(62,63,63,0.16)" },
      "ink-60":   { "value": "rgba(62,63,63,0.60)" },
      "peach-12": { "value": "rgba(233,130,106,0.12)" },
      "beige-30": { "value": "rgba(245,243,240,0.30)" }
    },
    "state": {
      "_comment": "Escala de estados única (choque 5). Alimenta los faroles. Todos pasan AA como texto sobre alabaster y sobre su tinte.",
      "success":       { "value": "#3d6b52", "onLight": 5.88 },
      "success-tint":  { "value": "#E8F2ED" },
      "error":         { "value": "#8a3030", "onLight": 7.90 },
      "error-tint":    { "value": "#F5E5E5" },
      "warning":       { "value": "#9a5020", "onLight": 5.68 },
      "warning-tint":  { "value": "#F5EBE5" },
      "info":          { "value": "#3B6691", "onLight": 5.10 },
      "info-tint":     { "value": "#E8EDF3" },
      "pending":       { "value": "#6F6867", "note": "Neutro/pendiente = graphite sobre tinte beige." },
      "pending-tint":  { "value": "#F5F3F0" }
    }
  },

  "semantic": {
    "_comment": "Capa semántica por rol. ESTO es lo que consumen los componentes, no el color crudo.",
    "bg":              { "value": "{color.brand.alabaster}" },
    "bg-alt":          { "value": "{color.brand.beige}" },
    "surface":         { "value": "{color.brand.white}" },
    "fg":              { "value": "{color.brand.ink}" },
    "fg-muted":        { "value": "{color.brand.graphite}", "note": "Texto secundario accesible (captions, meta, helpers)." },
    "fg-subtle":       { "value": "{color.brand.earth}", "note": "SOLO >=18px o decorativo." },
    "accent":          { "value": "{color.brand.peach}", "note": "Uso gráfico." },
    "accent-solid":    { "value": "{color.brand.peach-deep}", "note": "Botón/relleno de acento con texto." },
    "accent-contrast": { "value": "{color.brand.white}" },
    "divider":         { "value": "{color.brand.warm-grey}" },
    "border":          { "value": "1px solid {color.brand.warm-grey}" },
    "border-soft":     { "value": "1px solid {color.tint.ink-08}" },
    "focus-ring":      { "value": "0 0 0 3px rgba(233,130,106,0.35)", "note": "Halo peach + borde ink en el elemento enfocado." }
  },

  "typography": {
    "family": {
      "serif": { "value": "\"Valky\", \"Cormorant Garamond\", Georgia, serif", "use": "Titulares y prosa editorial. Nunca números." },
      "sans":  { "value": "\"Montserrat\", \"Helvetica Neue\", Arial, sans-serif", "use": "Cuerpo, UI, y SIEMPRE números (precios, %, fechas)." }
    },
    "load": {
      "valky":      { "weights": [300, 400, 600, 700], "format": "otf (self-hosted)" },
      "montserrat": { "weights": [400, 500, 600, 700], "source": "Google Fonts" },
      "cormorant":  { "weights": ["0,400", "0,500", "0,600", "1,300", "1,400"], "source": "Google Fonts", "note": "Fallback visible de Valky. Cargar en TODAS las apps." }
    },
    "scale": {
      "display": { "value": "clamp(56px, 9vw, 144px)" },
      "h1":      { "value": "clamp(40px, 6vw, 88px)" },
      "h2":      { "value": "clamp(28px, 4vw, 56px)" },
      "h3":      { "value": "clamp(22px, 2.4vw, 32px)" },
      "h4":      { "value": "18px" },
      "body":    { "value": "15px" },
      "small":   { "value": "12px" },
      "eyebrow": { "value": "11px" }
    },
    "tracking": {
      "tight":   { "value": "-0.01em", "use": "Serif display grande." },
      "normal":  { "value": "0.02em" },
      "wide":    { "value": "0.14em", "use": "Cuerpo Montserrat." },
      "eyebrow": { "value": "0.32em", "use": "Labels en mayúsculas." }
    },
    "lineHeight": {
      "display": { "value": "1.02" },
      "heading": { "value": "1.12" },
      "body":    { "value": "1.7" }
    }
  },

  "spacing": {
    "_comment": "Base 8px. Usar SIEMPRE estos pasos, no px sueltos.",
    "s-1": "4px", "s-2": "8px", "s-3": "16px", "s-4": "24px", "s-5": "32px",
    "s-6": "48px", "s-7": "64px", "s-8": "96px", "s-9": "128px", "s-10": "192px"
  },

  "layout": {
    "breakpoint": {
      "_comment": "Mobile-first (choque/decisión 9). El contenido colapsa a cards por debajo de md.",
      "sm": "480px", "md": "780px", "lg": "1080px"
    },
    "container": {
      "narrow": "640px", "standard": "1080px"
    }
  },

  "radius": {
    "_comment": "Botones y badges = pill. Inputs y cards = md (14, el radio de facto). Cards grandes y modales = xl.",
    "sm": "10px", "md": "14px", "lg": "18px", "xl": "28px", "2xl": "40px",
    "pill": "999px", "card-top": "28px 28px 0 0"
  },

  "shadow": {
    "_comment": "Cuatro niveles suaves, tinte ink. Se elimina el .12 de Guest en favor de lg.",
    "xs": "0 1px 2px rgba(62,63,63,0.04)",
    "sm": "0 4px 16px rgba(62,63,63,0.05)",
    "md": "0 12px 40px rgba(62,63,63,0.07)",
    "lg": "0 28px 80px rgba(62,63,63,0.10)"
  },

  "motion": {
    "ease":  "cubic-bezier(0.22, 0.61, 0.36, 1)",
    "fast":  "180ms", "med": "360ms", "slow": "720ms"
  },

  "icon": {
    "_comment": "Set Lucide curado, inline (sin CDN en runtime). Grosor único.",
    "strokeWidth": "1.5", "size-sm": "20px", "size-md": "24px", "color": "currentColor"
  },

  "dataviz": {
    "_comment": "Paleta categórica accesible. Orden de asignación de series. peach va al final: falla como marca fina (2.56), usar solo para rellenos/highlight con borde.",
    "series": [
      { "name": "ink",        "value": "#3E3F3F", "onLight": 10.12 },
      { "name": "green",      "value": "#3d6b52", "onLight": 5.88 },
      { "name": "terracotta", "value": "#9a5020", "onLight": 5.68 },
      { "name": "slate",      "value": "#5B6B72", "onLight": 5.31 },
      { "name": "gold",       "value": "#8a6320", "onLight": 5.18 },
      { "name": "peach",      "value": "#E9826A", "onLight": 2.56, "note": "Solo relleno/highlight, no marca fina." }
    ]
  },

  "domainBadges": {
    "_comment": "CAPA DE DOMINIO de EPI (decisión 10). Hereda forma/tipo del core; NO va en el core global. Colores regenerados con fórmula única: fondo tinte S30/L93, texto mismo tono que pasa AA >=4.5.",
    "limpieza-tradicional": { "bg": "#E8F3ED", "fg": "#317754", "aa": 4.74 },
    "limpieza-profunda":    { "bg": "#E8F3F0", "fg": "#317766", "aa": 4.67 },
    "mantenimiento":        { "bg": "#E8EDF3", "fg": "#3B6691", "aa": 5.10 },
    "nuevo-producto":       { "bg": "#F3EEE8", "fg": "#866537", "aa": 4.63 },
    "ajuste":               { "bg": "#F3F1E8", "fg": "#776C31", "aa": 4.67 },
    "danos":                { "bg": "#F3E9E8", "fg": "#91473B", "aa": 5.56 },
    "supervision":          { "bg": "#EEE8F3", "fg": "#6D3B91", "aa": 6.51 },
    "cancelacion":          { "bg": "#F3E8ED", "fg": "#913B66", "aa": 5.82 },
    "wifi":                 { "bg": "#E8F1F3", "fg": "#357682", "aa": 4.50 }
  }
}
